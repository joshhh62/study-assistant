# Copy this file to .env and fill in your key.

# Which provider to call. Currently supported: "groq" (OpenAI-compatible, free tier).
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model to use. llama-3.3-70b-versatile is a good default on Groq's free tier.
GROQ_MODEL=llama-3.3-70b-versatile

# If set to "true", the server returns canned fixture data instead of calling
# the LLM. Useful for developing/testing the frontend without burning API
# calls or needing a key yet. Must be "false" (or unset) for the real submission.
MOCK_MODE=false

PORT=3001
