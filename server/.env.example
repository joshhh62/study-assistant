# Copy this file to .env and fill in your key.

# Which provider to call. Currently supported: "groq" (OpenAI-compatible, free tier).
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model to use. llama-3.3-70b-versatile is a good default on Groq's free tier.
GROQ_MODEL=llama-3.3-70b-versatile

# Leave unset for real LLM calls. Set to one of the values below to test the
# frontend's loading/error/retry handling without calling the real API:
#   true   - always returns a valid canned study set
#   flaky  - first attempt is malformed, the server's built-in retry fixes it
#   broken - always malformed, so the request ultimately fails (tests the
#            "show an error, let the user retry" UI path)
MOCK_MODE=

PORT=3001
